{
  "_version": "1.73.1",
  "sap.app": {
    "id": "flightlk",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.19.3",
      "toolsId": "7da56d1c-6db1-4d32-9148-856d8e65cc9d"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_flight_lk_o4/srvd/sap/zui_flight_lk_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "flightlk.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FlightLKList",
          "target": "FlightLKList"
        },
        {
          "pattern": "FlightLK({key}):?query:",
          "name": "FlightLKObjectPage",
          "target": "FlightLKObjectPage"
        },
        {
          "pattern": "FlightLK({key})/_FlightDetailsLOR({key2}):?query:",
          "name": "FlightDetailsLORObjectPage",
          "target": "FlightDetailsLORObjectPage"
        }
      ],
      "targets": {
        "FlightLKList": {
          "type": "Component",
          "id": "FlightLKList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/FlightLK",
              "variantManagement": "Page",
              "navigation": {
                "FlightLK": {
                  "detail": {
                    "route": "FlightLKObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "FlightController": {
                      "press": "flightlk.ext.controller.FlightController.goToUrl",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Go to Web"
                    }
                  }
                }
              }
            }
          }
        },
        "FlightLKObjectPage": {
          "type": "Component",
          "id": "FlightLKObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/FlightLK",
              "navigation": {
                "_FlightDetailsLOR": {
                  "detail": {
                    "route": "FlightDetailsLORObjectPage"
                  }
                }
              },
              "content": {
                "body": {
                  "sections": {
                    "GeoMap": {
                      "template": "flightlk.ext.fragment.GeoMap",
                      "position": {
                        "placement": "After",
                        "anchor": "GeneralInfo"
                      },
                      "title": "Itinerary"
                    }
                  }
                }
              }
            }
          }
        },
        "FlightDetailsLORObjectPage": {
          "type": "Component",
          "id": "FlightDetailsLORObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/FlightLK/_FlightDetailsLOR"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
